<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aras.SreHub</RootNamespace>
    <AssemblyName>SreHub</AssemblyName>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.11.4" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.6.0" />
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <!-- The study library is data, not build input; it is only carried along on publish. -->
  <ItemGroup>
    <Content Remove="learning-content\**" />
    <None Include="learning-content\**" Exclude="learning-content\.sre-hub\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
